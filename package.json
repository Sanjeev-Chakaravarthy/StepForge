{
  "name": "stepforge",
  "version": "1.0.0",
  "description": "Headless, multi-tenant durable task orchestration and sandboxed execution engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "k6 run benchmarks/noisy_neighbor.js"
  },
  "keywords": [
    "orchestration",
    "durable-execution",
    "workflow",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "hono": "^4.13.20",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
